generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id            String        @id @default(cuid())
  companyName   String
  contactPerson String
  mobile        String
  email         String
  city          String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  enquiries     Enquiry[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]
}

model Product {
  id             String            @id @default(cuid())
  productCode    String            @unique
  productName    String
  category       String
  unit           String
  basePrice      Decimal           @db.Decimal(12, 2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  inventory      Inventory?
  enquiryItems   EnquiryItem[]
  quotationItems QuotationItem[]
  orderItems     SalesOrderItem[]
  dispatchItems  DispatchItem[]
}

model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  physicalQuantity  Int      @default(0)
  reservedQuantity  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Enquiry {
  id           String        @id @default(cuid())
  enquiryNumber String       @unique
  customerId   String
  enquiryDate  DateTime      @default(now()) @db.Date
  requiredDate DateTime?     @db.Date
  notes        String?
  status       EnquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        EnquiryItem[]
  quotations   Quotation[]

  @@unique([id, customerId])
  @@index([customerId])
}

model EnquiryItem {
  id        String   @id @default(cuid())
  enquiryId String
  productId String
  quantity  Int
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([enquiryId, productId])
  @@index([productId])
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  enquiryId       String
  customerId      String
  validUntil      DateTime        @db.Date
  status          QuotationStatus @default(DRAFT)
  grandTotal      Decimal         @default(0) @db.Decimal(14, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  enquiry         Enquiry         @relation(fields: [enquiryId, customerId], references: [id, customerId], onDelete: Restrict)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           QuotationItem[]
  salesOrder      SalesOrder?

  @@unique([id, customerId])
  @@index([enquiryId, customerId])
  @@index([customerId])
}

model QuotationItem {
  id               String    @id @default(cuid())
  quotationId      String
  productId        String
  quantity         Int
  unitPrice        Decimal   @db.Decimal(12, 2)
  discountPercent  Decimal   @default(0) @db.Decimal(5, 2)
  gstPercent       Decimal   @default(0) @db.Decimal(5, 2)
  lineAmount       Decimal   @db.Decimal(14, 2)
  quotation        Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([quotationId, productId])
  @@index([productId])
}

model SalesOrder {
  id          String           @id @default(cuid())
  orderNumber String           @unique
  customerId  String
  quotationId String           @unique
  orderDate   DateTime         @default(now()) @db.Date
  totalAmount Decimal          @db.Decimal(14, 2)
  status      SalesOrderStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation   Quotation        @relation(fields: [quotationId, customerId], references: [id, customerId], onDelete: Restrict)
  items       SalesOrderItem[]
  dispatch    Dispatch?

  @@unique([quotationId, customerId])
  @@index([customerId])
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  productId    String
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  lineAmount   Decimal    @db.Decimal(14, 2)
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([salesOrderId, productId])
  @@index([productId])
}

model Dispatch {
  id            String        @id @default(cuid())
  dispatchNumber String       @unique
  salesOrderId  String        @unique
  dispatchDate  DateTime      @default(now()) @db.Date
  vehicleNumber String
  driverName    String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  items         DispatchItem[]
}

model DispatchItem {
  id         String   @id @default(cuid())
  dispatchId String
  productId  String
  quantity   Int
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, productId])
  @@index([productId])
}
